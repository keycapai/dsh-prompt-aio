{
  "name": "dsh-prompt-aio",
  "version": "0.2.0",
  "description": "DSH Prompt AIO — meta bundle installing prompt_control, skill_control and tool_control as one unit. Four npm packages, one-command install.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "prompt-control",
    "skill-control",
    "tool-control"
  ],
  "dependencies": {
    "dsh-prompt-control": "^0.6.0",
    "dsh-skill-control": "^0.1.0",
    "dsh-tool-control": "^1.8.3"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --check lib/index.js"
  }
}
